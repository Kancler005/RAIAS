#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_TransformData
{
    float4x4 mvp;
    float4x4 normalMatrix;
};

struct type_ObjectData
{
    float4 objectColor;
};

struct main0_out
{
    float3 out_var_TEXCOORD0 [[user(locn0)]];
    float3 out_var_TEXCOORD1 [[user(locn1)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float3 in_var_TEXCOORD1 [[attribute(1)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_TransformData& TransformData [[buffer(0)]], constant type_ObjectData& ObjectData [[buffer(1)]])
{
    main0_out out = {};
    out.gl_Position = TransformData.mvp * float4(in.in_var_TEXCOORD0, 1.0);
    out.out_var_TEXCOORD0 = fast::normalize((TransformData.normalMatrix * float4(in.in_var_TEXCOORD1, 0.0)).xyz);
    out.out_var_TEXCOORD1 = ObjectData.objectColor.xyz;
    return out;
}


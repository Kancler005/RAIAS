#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_GlyphCameraData
{
    float4x4 viewProjection;
    float4 cameraRight;
    float4 cameraUp;
    float4 glyphSettings;
};

struct main0_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float out_var_TEXCOORD1 [[user(locn1)]];
    float4 out_var_TEXCOORD2 [[user(locn2)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float2 in_var_TEXCOORD1 [[attribute(1)]];
    float in_var_TEXCOORD2 [[attribute(2)]];
    float in_var_TEXCOORD3 [[attribute(3)]];
    float4 in_var_TEXCOORD4 [[attribute(4)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_GlyphCameraData& GlyphCameraData [[buffer(0)]])
{
    main0_out out = {};
    out.gl_Position = GlyphCameraData.viewProjection * float4((in.in_var_TEXCOORD0 + ((GlyphCameraData.cameraRight.xyz * in.in_var_TEXCOORD1.x) * (GlyphCameraData.glyphSettings.x * in.in_var_TEXCOORD3))) + ((GlyphCameraData.cameraUp.xyz * in.in_var_TEXCOORD1.y) * (GlyphCameraData.glyphSettings.y * in.in_var_TEXCOORD3)), 1.0);
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD1 + float2(0.5);
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD2;
    out.out_var_TEXCOORD2 = in.in_var_TEXCOORD4;
    return out;
}

